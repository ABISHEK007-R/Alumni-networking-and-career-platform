#!/bin/sh
set -e
MAVEN_VERSION=3.9.11
MAVEN_HOME="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/.mvn/apache-maven-${MAVEN_VERSION}"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Maven ${MAVEN_VERSION} is not installed. Run mvnw.cmd on Windows or install Maven on this system."
  exit 1
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
